{
  "name": "touch-grass-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.23.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "dev:vars": "tsx tools/local-env.ts",
    "dev:provider": "tsx tests/fixtures/provider-double.ts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "lint": "oxlint && node --import tsx tools/boundary-enforcement/lint-rules/check-source.ts",
    "check:boundaries": "node --import tsx tools/boundary-enforcement/check-boundaries.ts",
    "check:repo": "tsx tools/boundary-enforcement/check-repo.ts",
    "check:fast": "pnpm lint && pnpm check:boundaries && pnpm check:repo",
    "gen:architecture": "tsx tools/boundary-enforcement/generate-architecture.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:db": "supabase test db",
    "test:db:races": "node --import tsx tests/database/races.ts",
    "test:e2e": "playwright test",
    "check:bundle": "tsx tools/boundary-enforcement/check-client-bundle.ts",
    "check": "tsx tools/check.ts",
    "verify:deployed": "tsx tools/verify-deployed.ts",
    "db:reset": "supabase db reset --local",
    "db:diff": "supabase db schema declarative sync --no-apply -f",
    "db:types": "supabase gen types typescript --local --schema account_api,agent_chat_api > src/platform/database.types.ts",
    "cf:types": "tsx tools/worker-types.ts"
  },
  "dependencies": {
    "@openai/agents": "0.20.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/router-core": "1.171.38",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "openai": "7.34.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@oxlint/plugins": "1.88.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.6.0",
    "jose": "6.2.12",
    "oxlint": "1.88.0",
    "pg": "8.23.1",
    "shadcn": "4.22.0",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.0",
    "wrangler": "4.151.1"
  }
}
